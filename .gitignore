# Publish only maintained source; preserve local evidence and tools on disk.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/package.json
!/extensions/
/extensions/*
!/extensions/codex-code-review-usage/
!/tools/
/tools/*
!/tools/Build-ExtensionIcon.ps1
!/docs/
/docs/*
!/docs/CHANGELOG.md
# Never commit credentials, local snapshots, dependencies, or generated output.
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.pem
**/*.key
**/.codex-review/
**/*.log
**/*.tmp
**/*.vsix
